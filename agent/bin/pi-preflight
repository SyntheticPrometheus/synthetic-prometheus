#!/usr/bin/env python3
"""pi-preflight — the checks that must pass before anything is published or a loop run is trusted.

  pi-preflight            run every check, exit 1 on any failure
  pi-preflight --quiet    only print failures

Each check exists because something went wrong once (see INCIDENTS.md):
  secrets      auth.json / key shapes must not be in the git tree or the publish snapshot
  license      the published snapshot must carry an OSI-approved license and no proprietary header
  judge        selfimprove/selftest.py must show good->PASS and bad->FAIL for every task
  ledger       selfimprove/maintain.py --check --research --lineage must pass
  memory       every research/*.md must be cited by a memory row
  research     every `status: done` digest in a registered pi-research run must pass its gate
  resources    enough RAM and disk to run a loop without OOM-killing the session
  graph        the percolation model of the machine must not get more fragile than its baseline
  frontmatter  every skill/agent/prompt frontmatter must parse as YAML (pi drops what does not)
  panel        the owner's panel indicators exist, emit valid genmon XML, and a click actually fires
"""
import ast
import calendar
import json
import math
import os
import re
import shutil
import subprocess
import time
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

HOME = Path.home()
AGENT = HOME / ".pi" / "agent"
PUB = AGENT / "publish" / "repo"
OSI = ("MIT License", "Apache License", "BSD", "GNU GENERAL PUBLIC LICENSE", "Mozilla Public License",
       "ISC License", "The Unlicense", "Creative Commons Zero")
# header-like phrases only: a bare "proprietary" in prose (e.g. this repo's own policy text) is not a license
PROPRIETARY = re.compile(r"(?i)(all rights reserved|proprietary and confidential|"
                         r"do not distribute|internal use only|confidential —)")
SECRETS = [r"sk-[A-Za-z0-9_-]{20,}", r"gh[pousr]_[A-Za-z0-9]{20,}", r"github_pat_[A-Za-z0-9_]{20,}",
           r"xox[baprs]-[A-Za-z0-9-]{10,}", r"AKIA[0-9A-Z]{16}", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"]

results = []


def record():
    """Persist every run, so "has this guard ever fired" is answerable.

    2026-11-19: 34 gated checks ran on every publish and no run was stored anywhere, so a check
    that has never failed could not be told from a check that cannot fail — the 2026-11-17
    "selftest nobody had run" incident one level up. Append-only; a write failure is silence,
    never a publish block.
    """
    try:
        p = AGENT / "events" / "preflight.jsonl"
        p.parent.mkdir(parents=True, exist_ok=True)
        ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with p.open("a") as f:
            for name, ok, detail in results:
                f.write(json.dumps({"ts": ts, "check": name, "ok": bool(ok),
                                    "detail": (detail or "")[:200]}) + "\n")
    except Exception:
        pass


def check(name, fn):
    try:
        ok, detail = fn()
    except Exception as e:  # a check that crashes is a failure, not a pass
        ok, detail = False, f"crashed: {e}"
    results.append((name, ok, detail))


def secrets():
    bad = []
    tree = subprocess.run(["git", "-C", str(AGENT), "ls-files"], capture_output=True, text=True).stdout
    for f in tree.splitlines():
        if Path(f).name in ("auth.json", "models-store.json") or f.startswith(("sessions/", "memory/journal/")):
            bad.append(f"tracked: {f}")
    # scan only what could ever be published: git-tracked files and the publish snapshot.
    # sessions/ and memory/ are local-only by construction, so a key in a transcript is not a leak.
    targets = [AGENT / f for f in tree.splitlines()] + (
        [p for p in PUB.rglob("*")] if PUB.exists() else [])
    for p in targets:
            if not p.is_file() or ".git" in p.parts:
                continue
            if any(x in p.parts for x in (".venv", "venv", "node_modules", "__pycache__")):
                continue
            if p.name in ("auth.json", "models-store.json"):
                continue  # allowed on disk; the git-tracking check above is what matters
            if p.stat().st_size > 2_000_000:
                continue
            try:
                body = p.read_text(errors="ignore")
            except Exception:
                continue
            for pat in SECRETS:
                if re.search(pat, body):
                    bad.append(f"{p.name}: {pat}")
    return (not bad), "; ".join(bad[:5]) or "clean"


def license():
    lic = PUB / "LICENSE"
    if not lic.exists():
        return False, "publish snapshot has no LICENSE"
    body = lic.read_text()
    if not any(k in body for k in OSI):
        return False, "LICENSE is not a recognised OSI license"
    hits = []
    for p in PUB.rglob("*"):
        if p.is_file() and ".git" not in p.parts and p.suffix in (".md", ".py", ".sh", ".ts", ".json"):
            if PROPRIETARY.search(p.read_text(errors="ignore")):
                hits.append(str(p.relative_to(PUB)))
    return (not hits), ("proprietary header in: " + ", ".join(hits[:3])) if hits else "OSI license present"


def judge():
    r = subprocess.run([sys.executable, str(AGENT / "selfimprove" / "selftest.py")],
                       capture_output=True, text=True)
    return r.returncode == 0, (r.stdout.strip().splitlines() or ["no output"])[-1]


def ledger():
    r = subprocess.run([sys.executable, str(AGENT / "selfimprove" / "maintain.py"),
                        "--check", "--research", "--lineage"], capture_output=True, text=True)
    return r.returncode == 0, (r.stdout.strip().splitlines() or ["no output"])[-1]


def allowlist():
    """The publish allowlist, read from bin/pi-publish so there is one list, not two."""
    src = (AGENT / "bin" / "pi-publish").read_text()
    tree = ast.parse(src)
    for node in tree.body:
        if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", "") == "ALLOW":
            return ast.literal_eval(node.value)
    return []


def publishable():
    """Files that could leave this host: the publish snapshot plus what the allowlist would copy."""
    tree = subprocess.run(["git", "-C", str(AGENT), "ls-files"], capture_output=True, text=True).stdout
    allow = set(allowlist())
    targets = [AGENT / f for f in tree.splitlines()
               if f in allow or any(f.startswith(a + "/") for a in allow)]
    if PUB.exists():
        targets += [p for p in PUB.rglob("*")]
    return [p for p in targets
            if p.is_file() and ".git" not in p.parts and p.stat().st_size <= 2_000_000]


def chat_private():
    """The owner's chat is not publishable material.

    2026-11-17: the owner's texts (and this channel's topic) sit in the local journals and in session
    logs; a session log published by accident publishes the channel, and nothing but the publish
    allowlist stood between those two facts. Candidate and then declined an inbound signing secret
    (bug #214) on the basis that there is no public path to the chat, so the no-public-post promise
    has to be a check that runs, not a policy sentence.
    """
    bodies = []
    store = AGENT / "text"
    for name in ("inbox.jsonl",):
        p = store / name
        if not p.exists():
            continue
        for line in p.read_text(errors="ignore").splitlines()[-400:]:
            try:
                t = " ".join(str(json.loads(line).get("text", "")).split())
            except Exception:
                continue
            if len(t) >= 40:
                bodies.append(t[:60])
    hits = []
    for p in publishable():
        if store in p.parents or "sessions" in p.parts:
            hits.append(f"{p} is publishable chat/journal material")
            continue
        body = p.read_text(errors="ignore")
        hits += [f"{p.name} quotes a text message" for b in bodies[:400] if b in body][:1]
    return (not hits), "; ".join(hits[:3]) or f"{len(bodies)} text message(s) absent from publishable files"


TEXT_TOPIC = "pi/text-topic"
GH_TOPIC = "pi/github-webhook-topic"
# Executables allowed to name the text topic: the publisher, the presence checker, and comments
# that explicitly say it is an entry name, not a value. A new entry is a deliberate decision, so a
# new publisher cannot appear silently (task #117's reopen condition).
TEXT_TOPIC_READERS = {
    "bin/pi-text", "bin/pi-accounts", "bin/pi-publish", "bin/pi-commit-guard.py",
    "bin/pi-preflight", "tests/pi-text.sh",
}


def pass_value(name):
    """Read one pass entry's value; None when it is missing. Never printed by the caller."""
    try:
        r = subprocess.run(["pass", "show", name], capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    lines = r.stdout.splitlines()
    return lines[0].strip() if r.returncode == 0 and lines and lines[0].strip() else None


def text_auth():
    """The text channel's only inbound credential is the ntfy topic name (bug #117).

    2026-11-17: the owner declined an inbound signing secret (#214) on the basis that the topic
    (84+ bits, never public) has no public path. That makes topic secrecy the design of record,
    with two reopening conditions: the topic is learned/shared, or a second publisher appears.
    This check is where those stop being prose — it fails if the topic is guessable, if its value
    is on the public path (publishable files or the publish repo's history), if the GitHub
    webhook publishes into the same topic, or if a new executable starts reading the topic.
    """
    cfg = {}
    try:
        cfg = json.loads((AGENT / "text" / "config.json").read_text())
    except Exception:
        pass
    transport = cfg.get("transport") or ("telegram" if pass_value("pi/telegram-bot-token") else "ntfy")
    if transport == "telegram":
        return True, "sender is bound to the telegram chat id; the ntfy topic is not the live path"
    topic = pass_value(TEXT_TOPIC)
    if not topic:
        return False, "no ntfy topic in pass (pi/text-topic): the channel has no credential"
    bits = len(topic) * math.log2(max(2, len(set(topic))))
    if bits < 80:
        return False, f"ntfy topic is only ~{bits:.0f} bits — guessable, not a credential (#117)"
    leaks = []
    for p in publishable():
        try:
            if topic in p.read_text(errors="ignore"):
                leaks.append(str(p))
        except Exception:
            continue
    if leaks:
        return False, ("the only sender credential is in publishable file(s): "
                       + ", ".join(leaks[:3]) + " — rotate the topic and reopen #117")
    if (PUB / ".git").exists():
        r = subprocess.run(["git", "-C", str(PUB), "log", "--all", "--oneline", "-S", topic],
                           capture_output=True, text=True, timeout=30)
        if r.stdout.strip():
            return False, "the ntfy topic appears in the publish repo history — rotate and reopen #117"
    gh = pass_value(GH_TOPIC)
    if gh and gh == topic:
        return False, "the GitHub webhook publishes into the text topic: a second sender (#117)"
    refs = []
    tree = subprocess.run(["git", "-C", str(AGENT), "ls-files"],
                          capture_output=True, text=True).stdout
    for f in tree.splitlines():
        if not f.endswith((".py", ".sh")) or f in TEXT_TOPIC_READERS:
            continue
        try:
            if TEXT_TOPIC in (AGENT / f).read_text(errors="ignore"):
                refs.append(f)
        except Exception:
            continue
    if refs:
        return False, ("new code reads the text topic: " + ", ".join(sorted(refs)[:3])
                       + " — a second publisher is #117's reopen condition")
    return True, (f"ntfy topic is the only credential ({bits:.0f} bits), absent from publishable "
                  "files and history; no second publisher")


def credentials():
    """Every password in the store must be absent from the git tree and the publish snapshot."""
    store = HOME / ".password-store"
    if not store.exists():
        return True, "no store"
    secrets = []
    for f in store.rglob("*.gpg"):
        r = subprocess.run(["pass", "show", str(f.relative_to(store))[:-4]],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            first = r.stdout.splitlines()[0].strip()
            if len(first) >= 8 and not first.startswith("no-password"):
                secrets.append((str(f.relative_to(store))[:-4], first))
    hits = []
    for p in publishable():
        try:
            body = p.read_text(errors="ignore")
        except Exception:
            continue
        for name, secret in secrets:
            if secret in body:
                hits.append(f"{p.name} contains the password for {name}")
    return (not hits), "; ".join(hits[:3]) or f"{len(secrets)} stored secret(s) absent from publishable files"


def snapshot():
    """The publish repo must be a working repo, not a half-built directory."""
    problems = []
    for name in ("README.md", "LICENSE", "PUBLISHING.md"):
        if not (PUB / name).exists():
            problems.append(f"missing {name}")
    if not (PUB / ".git").exists():
        problems.append("no .git (render deleted it?)")
    else:
        if (PUB / ".git" / "rebase-merge").exists() or (PUB / ".git" / "rebase-apply").exists():
            problems.append("stuck mid-rebase")
        rem = subprocess.run(["git", "-C", str(PUB), "remote"], capture_output=True, text=True).stdout.strip()
        if not rem:
            problems.append("no git remote")
        br = subprocess.run(["git", "-C", str(PUB), "rev-parse", "--abbrev-ref", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
        if br != "main":
            problems.append(f"on branch {br!r}, expected main")
    return (not problems), "; ".join(problems) or "snapshot repo healthy"


def resources():
    mem = 0
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            mem = int(line.split()[1]) // 1024
    free = shutil.disk_usage(HOME).free // (1024 ** 3)
    ok = mem >= 1200 and free >= 2
    return ok, f"{mem} MB RAM available, {free} GB disk"


def graph():
    """A single resource that takes a fifth of the machine with it should be a named, measured risk
    rather than something met during an outage.

    `pi-percolate` models every capability (bin/, enabled units, exec obligations, MCP servers) as a
    node whose required resources must all be up, and percolation is then the ordinary question of
    what share of that graph still runs *and* can reach itself after f of the resources fail. This
    gate does not re-derive the model: it fails only when fragility regressed against the recorded
    baseline or a new unmitigated single point of failure appeared, so it cannot latch on a state
    nobody intends to fix (the failure mode that made `units` unpassable once).
    """
    r = subprocess.run([str(AGENT / "bin" / "pi-percolate"), "check", "--quick"],
                       capture_output=True, text=True, timeout=180)
    lines = [l for l in (r.stdout or r.stderr).strip().splitlines() if l.strip()]
    return r.returncode == 0, (lines[-1] if lines else f"exit {r.returncode}")


def units():
    """A failed unit is a broken capability that nobody looks at again until it is asked for.

    Two system units sat failed for 11h (snapper-boot: no config declared; grub-btrfsd: missing
    inotify-tools) because nothing in the harness ever read `systemctl --failed`.
    """
    # A unit that runs this check cannot be its own evidence: once pi-review failed because
    # preflight failed because pi-review had failed, the latch was permanent. Harness units are
    # judged by their own checks (review, timers, publish) instead.
    harness = {"pi-review.service", "pi-selfimprove.service", "pi-publish.service",
               "pi-preflight.service", "pi-agenda.service"}
    bad = []
    for scope in (["--system"], ["--user"]):
        r = subprocess.run(["systemctl", *scope, "--failed", "--no-legend", "--plain"],
                           capture_output=True, text=True)
        bad += [l.split()[0].lstrip("\u25cf\u00d7*") for l in r.stdout.splitlines()
                if l.strip() and l.split()[0].lstrip("\u25cf\u00d7*") not in harness]
    # a test that installs a unit and forgets it leaves a live ExecStart behind: 2026-11-17 found
    # done@.service and marker@.service from an OnSuccess experiment, both writing to /tmp/ntest.
    stray = []
    for u in sorted((Path.home() / ".config" / "systemd" / "user").glob("*.service")):
        try:
            body = u.read_text(errors="ignore")
        except OSError:
            continue
        if re.search(r"(?m)^ExecStart=.*\s/tmp/", body):
            stray.append(u.name)
    if bad or stray:
        detail = []
        if bad:
            detail.append("failed: " + ", ".join(bad))
        if stray:
            detail.append("stray test unit(s): " + ", ".join(stray))
        return False, "; ".join(detail)
    return True, "no failed units, no stray test units"


def windows():
    """A terminal or session opened for a task must be tiled while it is used and gone when it is
    not. `pi-term` records what it opened; this check fails on an orphan (a pi-* tmux session whose
    pane is no longer pi) or a target older than the 12 h TTL. It never closes anything — `pi-term
    --reap` is the mutating command, on the 6 h agenda row.
    """
    r = subprocess.run([str(AGENT / "bin" / "pi-term"), "--list", "--json"],
                       capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return False, (r.stderr.strip().splitlines() or ["pi-term --list failed"])[-1]
    d = json.loads(r.stdout or "{}")
    rows = d.get("rows") or []
    open_rows = [x for x in rows if x.get("state") == "open"]
    stale = [x for x in rows if x.get("state") == "stale"]
    if d.get("orphans"):
        return False, f"{d['orphans']} orphan pi-term target(s) — run `pi-term --reap`"
    if stale:
        return False, f"{len(stale)} pi-term target(s) older than TTL — run `pi-term --reap`"
    wm = wm_singleton()
    if wm:
        return False, wm
    off = pergola_offscreen()
    if off:
        return False, off
    storm = notification_storm()
    if storm:
        return False, storm
    return True, f"{len(open_rows)} open pi-term target(s), 0 orphans, one WM, {notifications()} notification window(s)"


def notifications() -> int:
    """How many notification popups are open right now (0 when there is no display)."""
    if not os.environ.get("DISPLAY"):
        return 0
    try:
        r = subprocess.run(["wmctrl", "-l"], capture_output=True, text=True, timeout=15)
    except (subprocess.SubprocessError, OSError):
        return 0
    return sum(1 for ln in (r.stdout or "").splitlines() if ln.split()[3:4] == ["xfce4-notifyd"])


def notification_storm(limit: int = 10) -> str | None:
    """A pile of notification popups is a screen the owner cannot use, and no check looked at it.

    2026-11-20: a screenshot showed 221 windows titled "xfce4-notifyd" tiled over the whole
    desktop — every run of `pi-done --selftest` posted a real "job FAILED" notification (DISPLAY
    was set) with `-t 0` (never expire), and pergola arranges a notification like any other window.
    The registry check below counted 0 pi-term targets the whole time. The screen is part of the
    system; count it.
    """
    n = notifications()
    if n > limit:
        return (f"{n} notification window(s) open (limit {limit}) — a storm, not a notice; dismiss "
                f"with `DISPLAY=:0 wmctrl -c xfce4-notifyd`")
    return None


def pergola_offscreen() -> str | None:
    """A window that exists in pergola's tree but sits outside the work area is invisible.

    Measured 2026-11-15: the camera was framed on one pane, so three of four terminals were laid
    out at negative coordinates — `pi-tile status` called them `shown`, a screenshot showed one,
    and the owner's desktop looked like it had lost three windows. `pergola everything` restores
    the whole tree; this check notices the state, exactly as the WM-singleton check notices a
    displaced window manager.
    """
    tool = Path.home() / ".local" / "bin" / "pergola"
    if not tool.exists():
        return None
    try:
        r = subprocess.run([str(tool), "rects"], capture_output=True, text=True, timeout=20)
    except Exception:
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    work = subprocess.run(["xprop", "-root", "_NET_WORKAREA"], capture_output=True, text=True,
                          timeout=10).stdout
    nums = re.findall(r"-?\d+", work.split("=")[-1]) if "=" in work else []
    if len(nums) < 4:
        return None
    wx, wy, ww, wh = (int(n) for n in nums[:4])
    outside = []
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) < 5:
            continue
        try:
            x, y, w, h = (int(v) for v in parts[1:5])
        except ValueError:
            continue
        if x + w <= wx or y + h <= wy or x >= wx + ww or y >= wy + wh:
            outside.append(parts[0])
    if outside:
        return (f"{len(outside)} window(s) outside the work area ({', '.join(outside[:3])}) — the "
                f"pergola camera is framed into a pane; `pergola everything`")
    return None


def normalise_display(d: str | None) -> str | None:
    d = (d or "").strip()
    return d.split(".")[0] if d else None


def process_display(pid: int, argv: str) -> str | None:
    """The display a process is really on: an explicit `--display` wins, else its environment."""
    m = re.search(r"--display[= ](\S+)", argv or "")
    if m:
        return normalise_display(m.group(1))
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes().decode("utf-8", "replace")
    except OSError:
        return None
    for kv in raw.split("\0"):
        if kv.startswith("DISPLAY="):
            return normalise_display(kv[8:])
    return None


def wms_on_display(rows: list[tuple[int, str]], target: str) -> list[tuple[int, str]]:
    """Window managers that are on `target`, not on a test display.

    Measured 2026-11-15: the first version of this check counted every xfwm4 whose command line
    lacked `--display` as being on :0, so two leaked test managers (`DISPLAY=:78`, `:79`) failed the
    guard on a healthy desktop. The display has to come from the process itself: `--display` if
    given, otherwise the DISPLAY in its environment.
    """
    out = []
    for pid, argv in rows:
        if process_display(pid, argv) == target:
            out.append((pid, argv))
    return out


def wm_singleton() -> str | None:
    """Exactly one window manager may own a display, or windows get managed by one and drawn by none.

    2026-11-15: a previous session left `xfwm4 --compositor=off` running beside the real WM on :0;
    the displaced WM still answered `_NET_SUPPORTING_WM_CHECK`, pergola still reported every window
    as `shown` at a correct rect, and screenshots came back with whole terminals missing. Nothing
    noticed for 18 h. One `xfwm4 --replace` gives a clean single owner; this check notices instead.
    """
    target = normalise_display(os.environ.get("PI_WM_DISPLAY") or os.environ.get("DISPLAY") or ":0")
    if not target or not Path("/tmp/.X11-unix").is_dir():
        return None
    r = subprocess.run(["pgrep", "-af", "^xfwm4 "], capture_output=True, text=True)
    rows = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            rows.append((int(parts[0]), parts[1]))
    ours = wms_on_display(rows, target)
    if len(ours) > 1:
        detail = "; ".join(f"pid {pid} ({argv[:34]})" for pid, argv in ours)
        return (f"{len(ours)} window managers on {target} ({detail}) — restart with one "
                f"`xfwm4 --replace`")
    return None


def swap_snapshot_guard():
    """An active btrfs swapfile inside a snapshotted subvolume fails every snapshot with ETXTBSY.

    The 4 GB OOM backstop was created at /swap/swapfile inside @; snapper's timeline service then
    failed hourly for 6 h ("create snapshot failed, errno:26") while every other check was green.
    The fix is a nested subvolume: /swap is now a subvolume, so @ snapshots do not recurse into it.
    This check walks each snapper SUBVOLUME and fails if a file-backed swap sits inside it without
    an intervening subvolume.
    """
    r = subprocess.run(["swapon", "--show=NAME", "--noheadings"], capture_output=True, text=True)
    files = [x.strip() for x in r.stdout.splitlines() if x.strip().startswith("/")]
    if not files:
        return True, "no file-backed swap"
    confs = []
    for c in Path("/etc/snapper/configs").glob("*"):
        for line in c.read_text(errors="ignore").splitlines():
            if line.startswith("SUBVOLUME="):
                confs.append((c.name, line.split("=", 1)[1].strip().strip('"')))
    bad = []
    for f in files:
        cur = Path(f).parent
        protected = False
        while True:
            if subprocess.run(["sudo", "-n", "btrfs", "subvolume", "show", str(cur)],
                              capture_output=True).returncode == 0:
                protected = True
                break
            if cur == cur.parent or cur == Path("/"):
                break
            cur = cur.parent
        if protected:
            continue
        for name, sub in confs:
            if str(Path(f)).startswith(sub.rstrip("/") + "/"):
                bad.append(f"{f} inside snapper:{name} ({sub}) — wrap it in a nested subvolume")
    return (not bad), ("; ".join(bad) if bad else f"{len(files)} file swap(s) outside snapshotted subvolumes")


def memory_guard():
    """Swap beyond zram, and a cap on the local model: a global OOM killed the session once."""
    swaps = [l.split()[0] for l in open("/proc/swaps").read().splitlines()[1:] if l.strip()]
    disk = [s for s in swaps if not s.startswith("/dev/zram")]
    mx = subprocess.run(["systemctl", "--user", "show", "-p", "MemoryMax", "--value",
                         "llama-router.service"], capture_output=True, text=True).stdout.strip()
    capped = mx not in ("", "infinity")
    return (bool(disk) and capped), (
        f"swap {'+'.join(s.split('/')[-1] for s in swaps) or 'none'}"
        f"{' (no disk backstop)' if not disk else ''}; llama-router MemoryMax={mx or 'unset'}")


def memory_pins():
    """Every pinned rule must actually reach the session prompt at the budget the boot uses.

    2026-11-20: `mem brief` allocated pinned rows first but returned 0 when it dropped one, and the
    boot extension asked for 700 tokens while seven live pins cost ~830 — so a rule the system
    promised to always load was silently absent from every session. The brief now exits 1, and
    this check reads that: the fix is the gate, not a note in the report.
    """
    r = subprocess.run([str(AGENT / "bin" / "mem"), "brief", "--budget", "1100"],
                       capture_output=True, text=True, timeout=120)
    out = r.stdout or ""
    core = next((l for l in out.splitlines() if l.startswith("## CORE")), "## CORE (pinned)")
    stats = next((l for l in out.splitlines() if l.startswith("## STATS")), "")
    if r.returncode != 0:
        why = next((l.strip() for l in out.splitlines() if "budget too small" in l),
                   (r.stderr or "").strip()[:120] or "brief exited non-zero")
        return False, f"a pinned rule does not fit: {why}"
    return True, f"{core.replace('## ', '')}; {stats.replace('## STATS ', '')}"


def laya_vml():
    """torch's bundled MKL dispatched an AVX-512 cos kernel on this AVX-only CPU and SIGILLed twice.

    The workaround is MKL_ENABLE_INSTRUCTIONS=SSE4_2 (mcp.json + bin/layaq). This check does not
    prove that dispatch choice, but it fails the run if the flag is missing or the exact VML call
    (rotary tables: 8192x32 float cos/sin) crashes in the laya venv.
    """
    flag = "MKL_ENABLE_INSTRUCTIONS"
    missing = []
    for f in (AGENT / "mcp.json", AGENT / "bin" / "layaq"):
        if flag not in f.read_text(errors="replace"):
            missing.append(f.name)
    if missing:
        return False, f"{flag} guard absent from {', '.join(missing)}"
    py = AGENT / "laya" / ".venv" / "bin" / "python"
    code = "import torch;torch.set_num_threads(2);p=torch.arange(8192.).float();i=torch.randn(32)*.01;" \
           "f=torch.outer(p,i);print(float((f.cos()+f.sin()).sum()))"
    env = dict(os.environ, MKL_ENABLE_INSTRUCTIONS="SSE4_2")
    r = subprocess.run([str(py), "-c", code], capture_output=True, text=True, env=env, timeout=300)
    if r.returncode != 0:
        return False, (f"SIGILL (rc={r.returncode}) " + r.stderr.strip().splitlines()[-1]) if r.stderr else f"rc={r.returncode}"
    return True, "MKL pinned to SSE4_2, rotary-table cos/sin clean"


def commit_guard():
    """The pre-commit secret guard must be installed and share pi-publish's shape list."""
    hook = AGENT / ".git" / "hooks" / "pre-commit"
    guard = AGENT / "bin" / "pi-commit-guard.py"
    if not guard.exists():
        return False, "bin/pi-commit-guard.py missing"
    if not hook.exists() or "pi-commit-guard" not in hook.read_text(errors="replace"):
        return False, "pre-commit hook not installed (bin/pi-commit-guard.py --install)"
    pub = (AGENT / "bin" / "pi-publish").read_text(errors="replace")
    gd = guard.read_text(errors="replace")
    rows = [l.strip() for l in pub.splitlines() if l.strip().startswith("(r\"")]
    stale = [r for r in rows if r not in gd]
    if stale:
        return False, f"{len(stale)} secret shape(s) in pi-publish absent from the guard's fallback"
    return True, "pre-commit hook installed, shapes in sync"


def review_fresh():
    """The reflection pass must actually be happening (bin/pi-review, weekly timer)."""
    rv = AGENT / "selfimprove" / "review.md"
    if not rv.exists():
        return False, "no selfimprove/review.md (run bin/pi-review)"
    age = (time.time() - rv.stat().st_mtime) / 86400
    if age > 10:
        return False, f"last review {age:.1f}d ago — the weekly reflection has stopped running"
    return True, f"last review {age:.1f}d ago"



def frontmatter():
    """Every skill, agent and prompt frontmatter must parse the way pi parses it.

    pi skips a resource whose frontmatter fails to parse and only prints a startup warning line,
    so a colon-then-space inside a plain scalar (which YAML reads as a nested mapping) quietly
    removed a skill from the prompt for hours. See INCIDENTS.md.
    """
    r = subprocess.run([str(AGENT / "bin" / "pi-fmcheck")], capture_output=True, text=True, timeout=180)
    out = (r.stdout or "").strip().splitlines()
    if r.returncode != 0:
        bad = [l for l in out if l.startswith("FAIL")]
        return False, "; ".join(bad[:3]) or (r.stderr.strip().splitlines() or ["frontmatter check failed"])[-1]
    return True, out[0].replace("OK  ", "") if out else "ok"


def skills():
    """The vendored skill pack must be structurally sound and have no unregistered local edits.

    Upstream moving on is not a failure (drift is reported as a warning below), but a merge left
    half-resolved, a frontmatter broken by an edit, or an edit missing from LOCAL-CHANGES.md is:
    that is how a self-improvement change silently disappears on the next update.
    """
    r = subprocess.run([str(AGENT / "bin" / "pi-skills"), "verify"], capture_output=True, text=True, timeout=180)
    out = (r.stdout or "").strip().splitlines()
    bad = [l for l in out if l.startswith("FAIL")]
    if r.returncode != 0:
        return False, "; ".join(bad[:3]) or (r.stderr.strip().splitlines() or ["verify failed"])[-1]
    return True, out[0].replace("OK  ", "") if out else "ok"


def repomap():
    """The code-intelligence tool must still parse, rank and serve MCP.

    A tool that silently stops extracting (a changed regex, a renamed dir) is the frontmatter
    failure again: nothing errors, the map just gets quietly worse. selftest.py runs on a
    throwaway fixture, so this never depends on which repos exist on the machine.
    """
    exe = AGENT / "skills" / "repomap" / "scripts" / "selftest.py"
    if not exe.exists():
        return False, "skills/repomap/scripts/selftest.py missing"
    r = subprocess.run([sys.executable, str(exe), "--quiet"], capture_output=True, text=True, timeout=180)
    if r.returncode != 0:
        bad = [l for l in (r.stderr or "").strip().splitlines() if l.startswith("FAIL")]
        return False, "; ".join(bad[:3]) or "repomap selftest failed"
    idx = subprocess.run([str(AGENT / "bin" / "pi-repomap"), "index", str(AGENT)],
                         capture_output=True, text=True, timeout=180)
    if idx.returncode != 0:
        return False, (idx.stderr or idx.stdout).strip().splitlines()[-1:] or "index failed"
    files = next((l.split()[1] for l in idx.stdout.splitlines() if l.startswith("files")), "?")
    return True, f"selftest green, {files} files indexed"


def web():
    """The offline half of the web tool must parse pages, cache and serve MCP.

    Network reachability is not a gate (a source being down is the internet's problem), but a
    parser that stops matching is mine and is silent — it returns "no results" and looks like an
    empty search. selftest.py runs on saved fixtures, so this needs no network.
    """
    exe = AGENT / "skills" / "web" / "scripts" / "selftest.py"
    if not exe.exists():
        return False, "skills/web/scripts/selftest.py missing"
    r = subprocess.run([sys.executable, str(exe), "--quiet"], capture_output=True, text=True, timeout=180)
    if r.returncode != 0:
        bad = [l for l in (r.stderr or "").strip().splitlines() if l.startswith("FAIL")]
        return False, "; ".join(bad[:3]) or "pi-web selftest failed"
    return True, "selftest green (parsers, extractor, cache, limiter, robots, MCP)"


def text_channel():
    """The owner's text channel must be alive: a silent poller is a message the owner thinks was read.

    2026-11-15: two of the owner's first messages were swallowed when the poller's task write hit a
    locked agenda DB (see INCIDENTS.md). This is the check that makes that class visible: parked
    messages, consecutive poll failures, or a poller that has not run for 45 minutes all fail.
    """
    tool = AGENT / "bin" / "pi-text"
    if not tool.exists():
        return False, "bin/pi-text missing"
    r = subprocess.run([str(tool), "check"], capture_output=True, text=True, timeout=60)
    detail = "; ".join(l.removeprefix("pi-text: ") for l in
                        (r.stdout + r.stderr).splitlines() if l.strip())[:200]
    return r.returncode == 0, detail or "ok"


def cost_cap():
    """Is the context ceiling that is configured the one that is running?

    2026-11-16: 62% of a $14/day burn sat above a 248k-token ceiling that settings.json claimed to
    enforce, while the observed compactions fired at 676k-1.11M tokensBefore — the setting had never
    applied to a live session, and nothing compared the two numbers. `pi-burn --cap` does that
    comparison offline (no network, no completion); it fails only when a compaction *after* the
    setting's mtime fired above the ceiling, and says "unverified" until one does.
    """
    tool = AGENT / "bin" / "pi-burn"
    if not tool.exists():
        return False, "bin/pi-burn missing"
    r = subprocess.run([str(tool), "--cap", "3"], capture_output=True, text=True, timeout=180)
    lines = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()]
    detail = ""
    for l in lines:
        if l.startswith(("ceiling", "above", "guard", "fail")):
            detail += (l.split(None, 1)[1] if " " in l else l) + " | "
    return r.returncode == 0, detail.strip(" |")[:220] or "no output"


def control():
    """The reactive controller must still be able to refuse: per-subsystem caps, event thresholds,
    decision TTL. 2026-11-17 (task #1985): a cap or a TTL that parses but never fires is the failure
    this host keeps repeating (pi-burn's ceiling that no session could reach), so the gate is the
    instrument's own 11-case selftest, run here, not a spend number.
    """
    tool = AGENT / "bin" / "pi-control"
    if not tool.exists():
        return False, "bin/pi-control missing"
    r = subprocess.run([str(tool), "doctor"], capture_output=True, text=True, timeout=120)
    out = (r.stdout + r.stderr).strip().splitlines()
    bad = [l.split(None, 1)[-1] for l in out if l.startswith("fail")]
    return r.returncode == 0, "; ".join(bad)[:220] or "ok"


def audit_pack():
    """The audit's own evidence pack must still answer, and must still catch its boundary cases.

    2026-11-16: `skills/audit/scripts/window.py` shipped with 24 defects that a two-tester panel
    found in the first hour (a truncated ledger erasing itself, an unreadable instrument reading as
    a real finding, crashes exiting 1 which is the same code as "suspects found"). The selftest
    re-proves each class in ~0.2 s with no network, so the guard runs on every publish rather than
    waiting for the next audit to notice.
    """
    tool = AGENT / "skills" / "audit" / "scripts" / "window.py"
    if not tool.exists():
        return False, "skills/audit/scripts/window.py missing"
    r = subprocess.run([sys.executable, str(tool), "selftest"], capture_output=True, text=True,
                       timeout=120)
    out = (r.stdout + r.stderr).strip().splitlines()
    cases = [l for l in out if l.startswith("selftest ")]
    bad = [l for l in out if l.rstrip().endswith("FAIL")]
    return r.returncode == 0, (f"{len(cases)} case(s): " + "; ".join(l[:90] for l in bad)) if bad \
        else f"{max(len(cases) - 1, 0)} boundary case(s) re-proved"


def decisions():
    """A decision past its review date is a decision nobody re-measured.

    2026-11-17: the earning-rail decision was recorded in four places and none of them could say
    when it would be read again. `bin/pi-decide` refuses a record with no runnable guard and no
    dated falsifier, and this check makes the review date real: an open record past `review-by`
    blocks publish until it is closed kept/reverted/superseded.
    """
    tool = AGENT / "bin" / "pi-decide"
    if not tool.exists():
        return False, "bin/pi-decide missing"
    r = subprocess.run([str(tool), "due"], capture_output=True, text=True, timeout=30)
    out = (r.stdout + r.stderr).strip().splitlines()
    if r.returncode == 0:
        return True, out[-1] if out else "no records"
    return False, "; ".join(l[:100] for l in out if l.startswith("OVERDUE")) or "pi-decide due failed"


def tools():
    """A tool is only a capability if it is pinned and deterministic.

    2026-11-17: 49 of 52 scripts in bin/ had no test and no selftest, so every session re-derived
    the same command with slightly different flags and nothing compared the runs. `pi-tool check`
    runs each pin twice and diffs the output; `pi-tool lint` fails on a polling loop (a sleep
    standing in for an event — use bin/pi-wait). Both are blocking here.
    """
    tool = AGENT / "bin" / "pi-tool"
    if not tool.exists():
        return False, "bin/pi-tool missing"
    r = subprocess.run([str(tool), "check", "--quiet"], capture_output=True, text=True, timeout=600)
    if r.returncode != 0:
        bad = [l for l in (r.stdout + r.stderr).splitlines() if l.startswith("FAIL")]
        return False, "; ".join(l[:90] for l in bad[:3]) or "pi-tool check failed"
    lst = subprocess.run([str(tool), "list", "--json"], capture_output=True, text=True, timeout=60)
    try:
        n = len([x for x in json.loads(lst.stdout or "[]") if x.get("pinned") != "-"])
    except (ValueError, TypeError):
        n = 0
    l = subprocess.run([str(tool), "lint", "--quiet"], capture_output=True, text=True, timeout=300)
    if l.returncode != 0:
        err = [x for x in (l.stdout + l.stderr).splitlines() if ": error " in x]
        return False, "; ".join(x[:90] for x in err[:3]) or "pi-tool lint failed"
    # the ratchet: the unpinned set is recorded once and may shrink, never grow. Without this the
    # "every tool is pinned" rule was prose — 48 of 52 scripts had no pin and nothing blocked.
    p = subprocess.run([str(tool), "pins", "--quiet"], capture_output=True, text=True, timeout=60)
    if p.returncode != 0:
        bad = [x for x in (p.stdout + p.stderr).splitlines() if x.startswith("FAIL")]
        return False, "; ".join(bad[:3])[:200] or "pin ratchet failed"
    return True, f"{n} pinned tool(s) green, no polling loop, pin ratchet holds"


def map_index():
    """The index must describe the tree that exists.

    MAP.md is generated from map.json plus a scan. A directory that appears with no purpose, a
    pointer to a path that was deleted, or a map rendered before the last rename is the same
    failure: the index says something false and a session trusts it instead of looking. The check
    is cheap (sorted path set, no content hashes) and blocks publish like every other guard.
    """
    tool = AGENT / "bin" / "pi-map"
    if not tool.exists():
        return False, "bin/pi-map missing"
    r = subprocess.run([str(tool), "--check"], capture_output=True, text=True, timeout=120)
    out = (r.stdout + r.stderr).strip().splitlines()
    if r.returncode != 0:
        bad = [x for x in out if x.startswith("FAIL")]
        return False, "; ".join(x[:90] for x in bad[:3]) or "pi-map --check failed"
    return True, (out[-1] if out else "map fresh")


def github_hooks():
    """Every repo this account owns must carry the webhook, and the stream must be live: a repo
    without a hook is a PR nobody hears about, and a half-open ntfy socket is the same silence
    while `systemctl is-active` still says active (2026-11-18: 26 h of GitHub events cached, none
    texted)."""
    w = AGENT / "bin" / "pi-github-watch"
    if not w.exists():
        return True, "no github watcher installed"
    out = subprocess.run([str(w), "hook", "--check"], capture_output=True, text=True, timeout=90)
    if out.returncode != 0:
        bad = [ln for ln in (out.stdout + out.stderr).splitlines() if "NO webhook" in ln or "missing" in ln]
        return False, "; ".join(bad[:3]) or "hook --check failed"
    live = subprocess.run([str(w), "check"], capture_output=True, text=True, timeout=30)
    if live.returncode != 0:
        return False, "stream not live (bin/pi-github-watch status)"
    return True, "all repos hooked, stream live"


def identity():
    """A repo must be commit-able the moment it exists.

    Measured 2026-11-17: the first commit to a fresh clone of pergola died with "Author identity
    unknown" because this machine had no global git identity at all — only the one repo carried a
    local user.email, so every other tree needed a `-c user.email=...` flag or failed. The identity
    is global; the check asks git the same question a commit asks (GIT_AUTHOR_IDENT) in every
    project, so the class cannot come back.
    """
    def cfg(key):
        return subprocess.run(["git", "config", "--global", "--get", key],
                              capture_output=True, text=True).stdout.strip()
    name, email = cfg("user.name"), cfg("user.email")
    if not name or not email:
        return False, (f"no global identity (name={name or 'MISSING'} email={email or 'MISSING'}) "
                       "— a fresh clone cannot commit")
    if name.lower() in ("host", "agent", "user") or any(
            s in email for s in ("@localhost", "@local", "example.com")):
        return False, f"global identity is a placeholder: {name} <{email}>"
    bad = []
    for repo in sorted((HOME / "Projects").glob("*/.git")):
        r = subprocess.run(["git", "-C", str(repo.parent), "var", "GIT_AUTHOR_IDENT"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            bad.append(repo.parent.name)
    if bad:
        return False, f"git cannot author a commit in: {', '.join(bad)}"
    return True, f"{name} <{email}>, every ~/Projects repo can author a commit"


def completions():
    """A detached job's unread failure is a failure.

    Measured 2026-11-17: the e2e suite run against pergola *after* merging PR #1 failed at 22:05:50Z and
    the event sat unseen while the merge was reported as measured (its unit job had passed). A failed
    completion that nobody reads is the same as no test at all, so it blocks publish until it is read.
    """
    tool = AGENT / "bin" / "pi-done"
    if not tool.exists():
        return False, "bin/pi-done missing"
    r = subprocess.run([str(tool), "check"], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        lines = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()]
        return False, (lines[0][:180] if lines else "pi-done check failed") + " — `pi-done log`, then `pi-done seen`"
    return True, "no unread failed completion"


def intent():
    """The router's policy must be the one that was replayed.

    Measured 2026-11-18: a 36-case design set scored 94.4% in-sample and 41.7% held-out, so a
    policy edit that nobody replayed is the normal way this router would rot. The baseline report
    carries the policy's hash; an edit without a fresh replay fails here, and `intent/eval.py
    --gate` is what refuses a policy that measured worse.
    """
    import hashlib
    d = AGENT / "intent"
    pol, base = d / "policy.json", d / "baseline.json"
    if not (AGENT / "bin" / "pi-intent").exists():
        return False, "bin/pi-intent missing"
    for f in (pol, base):
        if not f.exists():
            return False, f"intent/{f.name} missing"
    try:
        p = json.loads(pol.read_text())
        b = json.loads(base.read_text())
    except ValueError as e:
        return False, f"unparseable intent json: {e}"
    modes = p.get("modes") or []
    for fp in p.get("fast_paths") or []:
        try:
            re.compile(fp.get("pattern", ""))
        except re.error as e:
            return False, f"fast path {fp.get('name')}: {e}"
        if fp.get("mode") not in modes:
            return False, f"fast path {fp.get('name')} routes to unknown mode {fp.get('mode')}"
    if p.get("default_mode") not in modes:
        return False, f"default_mode {p.get('default_mode')} is not in modes"
    sha = hashlib.sha256(pol.read_bytes()).hexdigest()[:12]
    arms = b.get("arms") or {}
    if b.get("policy_sha") != sha:
        return False, (f"policy.json changed since the baseline ({sha} vs {b.get('policy_sha')}) — "
                       "replay it: python3 intent/eval.py --cases intent/heldout.json "
                       "--gate intent/baseline.json --write-baseline intent/baseline.json")
    if not arms.get("policy"):
        return False, "baseline has no 'policy' arm"
    return True, (f"policy {sha} measured on {b.get('n')} held-out cases "
                  f"(acc {arms['policy'].get('acc')}, unwanted {arms['policy'].get('unwanted_action')})")


def claims():
    """Parallel sessions must not own the same path, and the registry must be readable.

    Five sessions can be live in one tree at once (measured 2026-11-15). The commit guard enforces
    ownership per path; this check is the whole-machine view: overlapping reservations fail, leases
    of dead processes are reaped, and unleased sessions that are actively editing are reported so
    contention is visible instead of discovered through a lost edit.
    """
    tool = AGENT / "bin" / "pi-claim"
    if not tool.exists():
        return False, "bin/pi-claim missing"
    r = subprocess.run([str(tool), "conflicts"], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return False, "; ".join(l for l in (r.stdout + r.stderr).splitlines() if l.strip())[:200]
    s = subprocess.run([str(tool), "sessions"], capture_output=True, text=True, timeout=60)
    live = s.stdout.count("tree ")
    leaked = 0
    rp = tool.parent.parent / "claims"
    for f in rp.glob("*.json") if rp.is_dir() else []:
        try:
            json.loads(f.read_text())
        except ValueError:
            leaked += 1
    if leaked:
        return False, f"{leaked} unreadable lease file(s) in {rp}"
    return True, f"{live} live lease(s), no overlapping reservations"


def panel():
    """A panel indicator the owner asked for must be on the panel, its XML must parse, and a click
    must actually be executed — genmon 4.3.0 fires <txtclick>/<iconclick> and silently ignores a
    bare <click>, which is what the agenda and runtime indicators shipped with (touch probes: the
    tag never ran, so those clicks had never once worked, 2026-11-16). The mem indicator added that
    day is what made the class visible; this check is its guard.
    """
    kinds = ("bg", "fg", "due", "mem")
    problems = []
    # Deterministic half of the guard: the live loop below only meets a hostile name while such a
    # process happens to be resident (2026-11-16: a background job whose argv held `2>&1 &`
    # blanked the mem indicator). This one renders every panel against that text every time.
    st = subprocess.run([str(AGENT / "bin" / "pi-bg"), "--selftest"],
                        capture_output=True, text=True, timeout=60)
    if st.returncode != 0:
        problems.append("selftest: " + (st.stdout.strip() or st.stderr.strip() or "failed"))
    for kind in kinds:
        r = subprocess.run([str(AGENT / "bin" / "pi-bg"), "--panel", kind],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            problems.append(f"{kind}: pi-bg --panel {kind} exited {r.returncode}")
            continue
        try:
            root = ET.fromstring("<r>" + r.stdout + "</r>")
        except ET.ParseError as e:
            problems.append(f"{kind}: genmon XML does not parse ({e})")
            continue
        if root.find("click") is not None:
            problems.append(f"{kind}: bare <click> is ignored by genmon 4.3 - use <txtclick>")
        for tag in ("txtclick", "iconclick"):
            el = root.find(tag)
            if el is not None and not (el.text or "").strip():
                problems.append(f"{kind}: empty <{tag}>")
    if not os.environ.get("DISPLAY"):
        return not problems, "; ".join(problems) or "genmon XML ok (no DISPLAY: layout not read)"
    ids_txt = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-p", "/panels/panel-1/plugin-ids"],
                             capture_output=True, text=True, timeout=20).stdout
    ids = [int(l) for l in ids_txt.splitlines() if l.strip().isdigit()]
    if not ids:
        return False, "panel-1 has no plugin-ids (is xfce4-panel configured?)"
    on_panel = set()
    for pid in ids:
        cmd = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-p", f"/plugins/plugin-{pid}/command"],
                             capture_output=True, text=True, timeout=20).stdout.strip()
        if "pi-bg --panel" in cmd:            # `pi-bg --panel` with no kind is the background view
            on_panel.add(cmd.split()[-1] if len(cmd.split()) > 2 else "bg")
    for kind in kinds:                        # every class the owner asked for must be on the panel
        if kind not in on_panel:
            problems.append(f"{kind} indicator is not on panel-1")
    return not problems, "; ".join(problems) or f"{len(ids)} plugins, indicators {sorted(on_panel)}"


def delegation():
    """The delegation loop must close: a policy of record, computable flow, and a bounded share of
    dispatches nobody ever judged. A ledger full of unverified rows cannot support a KEEP/DROP rule;
    expiring stale rows is honest, leaving them unverified forever is not.
    """
    pol = AGENT / "delegation" / "policy.md"
    if not pol.exists() or "v3" not in pol.read_text()[:200]:
        return False, "delegation/policy.md missing or not v3"
    r = subprocess.run([str(AGENT / "bin" / "pi-delegate"), "flow", "--days", "30", "--json"],
                       capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return False, (r.stderr.strip().splitlines() or ["flow failed"])[-1]
    d = json.loads(r.stdout)
    n = d.get("dispatches") or 0
    if n == 0:
        return True, "no dispatches in 30d"
    unv = d.get("unverified_stale") or 0
    share = unv / n
    detail = (f"{n} dispatches, yield {d.get('first_pass_yield')}, "
              f"${d.get('cost_per_verified_pass')}/pass, {unv} stale-unverified ({share:.0%})")
    if share > 0.3:
        return False, detail + " — close with `pi-delegate verdict` or `expire`"
    return True, detail


def history():
    """Which checks have ever failed: a guard that never fired is a guard nobody proved."""
    runs, fails, last = {}, {}, {}
    p = AGENT / "events" / "preflight.jsonl"
    if not p.exists():
        print("no preflight history yet (events/preflight.jsonl)")
        return 0
    for line in p.read_text().splitlines():
        try:
            r = json.loads(line)
        except Exception:
            continue
        n = r["check"]
        runs[n] = runs.get(n, 0) + 1
        fails[n] = fails.get(n, 0) + (0 if r["ok"] else 1)
        last[n] = r["ts"]
    print(f"{'check':12s} {'runs':>5s} {'fails':>6s}  last")
    for n in sorted(runs, key=lambda n: (-fails[n], n)):
        print(f"{n:12s} {runs[n]:5d} {fails[n]:6d}  {last[n]}")
    never = [n for n in runs if not fails[n]]
    print(f"\n{len(runs)} check(s), {len(never)} never observed failing")
    return 0


def research_runs():
    """A registered research run must be finished before it is published.

    2026-11-19: `pi-research new` registers a topic and writes a seven-section digest skeleton, and
    nothing forced the skeleton to be filled — 5 topics sat at 21 contract failures while publish
    only checked that research/*.md was cited by memory. The gate runs `--done`, so a draft still
    being researched never blocks a push for an unrelated fix (the debators' decision rule: both
    sides converged on gating done digests, and 5/5 topics were drafts when this was written).
    """
    man = AGENT / "research" / "rr" / "manifest.json"
    if not man.exists():
        return True, "no research run registered"
    r = subprocess.run([str(AGENT / "bin" / "pi-research"), "check", "--done"],
                       capture_output=True, text=True, timeout=120)
    out = (r.stdout + r.stderr).strip().splitlines()
    line = out[-1] if out else "no output"
    if r.returncode == 0:
        return True, line
    return False, f"incomplete run: {line}"


def main():
    quiet = "--quiet" in sys.argv
    if "--history" in sys.argv:
        return history()
    check("review", review_fresh)
    check("commit-guard", commit_guard)
    check("secrets", secrets)
    check("license", license)
    check("judge", judge)
    check("ledger", ledger)
    check("delegation", delegation)
    check("windows", windows)
    check("panel", panel)
    check("swap", swap_snapshot_guard)
    check("credentials", credentials)
    check("chat-private", chat_private)
    check("text-auth", text_auth)
    check("snapshot", snapshot)
    check("resources", resources)
    check("graph", graph)
    check("units", units)
    check("memory", memory_guard)
    check("memory pins", memory_pins)
    check("laya-vml", laya_vml)
    check("research", research_runs)
    check("frontmatter", frontmatter)
    check("skills", skills)
    check("repomap", repomap)
    check("web", web)
    check("decisions", decisions)
    check("tools", tools)
    check("map", map_index)
    check("identity", identity)
    check("completions", completions)
    check("github hooks", github_hooks)
    check("intent", intent)
    check("claims", claims)
    check("text", text_channel)
    check("cost cap", cost_cap)
    check("audit pack", audit_pack)
    check("control", control)
    # non-fatal: mail transport is a capability, not a publish gate — but silent expiry is how the
    # Google login wall hurt the first time, so say it out loud every run
    try:
        r = subprocess.run([str(AGENT / "bin" / "pi-mail"), "check"], capture_output=True, text=True, timeout=60)
        mail = (r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr).strip() else "no output"
        if r.returncode != 0:
            mail = "EXPIRED — " + mail
    except Exception as e:
        mail = f"unavailable: {e}"
    print(f"warn mail      {mail}")
    # non-fatal: the earning rail. Token rot, gate changes and an ignored queue are all silent
    # otherwise — and an unworked queue is money I decided not to take.
    try:
        q = subprocess.run([str(AGENT / "bin" / "pi-frantic"), "queue"], capture_output=True, text=True, timeout=60)
        queued = len([l for l in q.stdout.splitlines() if l.strip()])
        s = subprocess.run([str(AGENT / "bin" / "pi-frantic"), "status"], capture_output=True, text=True, timeout=60)
        line = next((l for l in s.stdout.splitlines() if l.startswith("gate")), "status unavailable")
        gain = next((l for l in s.stdout.splitlines() if l.startswith("earnings")), "")
        print(f"warn frantic   {line.strip()}; {gain.strip()}; queue={queued}")
        if s.returncode != 0:
            print("warn frantic   TOKEN/API BROKEN — fix before the rail rots")
    except Exception as e:
        print(f"warn frantic   unavailable: {e}")
    # non-fatal: upstream moved past the pin. Not a failure — an unread update is how a lesson
    # gets silently overwritten, so the weekly review must see it.
    try:
        r = subprocess.run([str(AGENT / "bin" / "pi-skills"), "status"], capture_output=True, text=True, timeout=180)
        lines = r.stdout.splitlines()
        up = next((l for l in lines if l.startswith("upstream")), "")
        pred = next((l for l in lines if l.startswith("PREDICT")), "")
        unreg = [l for l in lines if l.startswith("UNREG")]
        drift = "no new commits" not in up
        msg = f"{up.strip()}" + (f"; {pred.strip()}" if pred else "") + (f"; {unreg[0].strip()}" if unreg else "")
        print(("warn skills    " if drift else "ok   skills-up ") + (msg or "unavailable"))
    except Exception as e:
        print(f"warn skills    drift check unavailable: {e}")
    # non-fatal: the internet matrix. A source that silently stops answering looks exactly like a
    # search with no results, so the last `pi-web doctor` run is reported every time.
    try:
        hp = Path.home() / ".cache" / "pi-web" / "health.json"
        if not hp.exists():
            print("warn web       no doctor run recorded — run bin/pi-web doctor")
        else:
            h = json.loads(hp.read_text())
            age = (time.time() - calendar.timegm(time.strptime(h["checked"], "%Y-%m-%dT%H:%M:%SZ"))) / 86400
            rows = h.get("rows", [])
            good = [r["name"] for r in rows if r.get("ok")]
            bad = [r["name"] for r in rows if not r.get("ok")]
            stale = " STALE (run bin/pi-web doctor)" if age > 7 else ""
            print(f"warn web       {len(good)}/{len(rows)} sources ok, doctor {age:.1f}d ago{stale}"
                  + (f"; down: {', '.join(bad)}" if bad else ""))
    except Exception as e:
        print(f"warn web       health unreadable: {e}")
    # non-fatal: offline readiness. Independence is a capability, and capabilities rot silently — a
    # stopped router or a broken venv means "no cloud" quietly became "no work". Checked weekly.
    try:
        import json as _json, urllib.request
        with urllib.request.urlopen("http://127.0.0.1:9931/health", timeout=5) as fh:
            up = _json.loads(fh.read()).get("status") == "ok"
        with urllib.request.urlopen("http://127.0.0.1:9931/v1/models", timeout=5) as fh:
            gguf = len(_json.loads(fh.read())["data"])
        laya = subprocess.run([str(AGENT / "laya/.venv/bin/python"), "-c", "import laya"],
                              capture_output=True, timeout=180).returncode == 0
        reports = sorted((AGENT / "local").glob("audit-*.md"))
        if reports:
            age = int((time.time() - reports[-1].stat().st_mtime) / 86400)
            freshness = f"audit {age}d old" + (" (stale: timer?)" if age > 9 else "")
        else:
            freshness = "no audit report yet"
        good = up and gguf > 0 and laya and (not reports or age <= 9)
        print(("ok   local     " if good else "warn local     ") +
              f"router {'up' if up else 'DOWN'}, {gguf} GGUF, laya {'ok' if laya else 'BROKEN'}, "
              f"{freshness}")
        # Guard (2026-11-16): a router-spawned model child sat in swap for 32 h holding 1.109 GB
        # of anon memory (14% of the box) while idle, and nothing was watching per-model
        # processes. A model nobody is asking must not stay resident, so it is checked.
        reap = subprocess.run([str(AGENT / "bin/pi-local-reap"), "--check", "--quiet"],
                              capture_output=True, text=True, timeout=120)
        if reap.returncode == 1:
            print("warn local     idle llama-server holding RAM - run bin/pi-local-reap")
        # Guard (2026-11-16): models.json declared 16384 ctx while the router served 8192, and
        # every turn of a session on a local model died with "request (12924 tokens) exceeds
        # the available context size (8192)". The declaration was the only number Pi read, and
        # nothing compared it to the prompt Pi actually sends. Both are checked now, and the
        # check sends no completion, so it cannot hang or cost anything.
        ctx = subprocess.run([str(AGENT / "bin/pi-local-ctx")],
                             capture_output=True, text=True, timeout=60)
        for line in (ctx.stdout.strip().splitlines() or ["ctx check produced no output"]):
            line = line.replace("ok   local ctx: ", "").replace("FAIL ", "")
            print(("ok   local ctx " if ctx.returncode == 0 else "warn local ctx ") + line)
        # The technology watch is the thing that keeps the independence verdict from going stale, so
        # a watch that silently stopped must be as visible as a stopped router.
        tw = subprocess.run([str(AGENT / "bin/pi-techwatch"), "--check"],
                            capture_output=True, text=True, timeout=120)
        print(("ok   watch     " if tw.returncode == 0 else "warn watch     ") +
              tw.stdout.strip().replace("techwatch: ", "") if tw.stdout.strip() else "warn watch     no output")
    except Exception as e:
        print(f"warn local     offline path unavailable: {e}")
    failed = [r for r in results if not r[1]]
    record()
    for name, ok, detail in results:
        if not quiet or not ok:
            print(f"{'ok  ' if ok else 'FAIL'} {name:10s} {detail}")
    if failed:
        print(f"\n{len(failed)} check(s) failed — do not publish, fix the guard first")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
