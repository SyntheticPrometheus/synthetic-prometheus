#!/usr/bin/env python3
"""pi-accounts — is the identity in IDENTITY.md still true?

The account register is only worth having if it is checked. This verifies the parts that can go
silently wrong: the SSH key and its public half drifting apart, the git author identity changing,
a pass entry that no longer decrypts, the home symlink disappearing, the token losing its identity
or scopes, a repo becoming unreachable, or the mailbox going deaf.

    pi-accounts                  # everything, network included
    pi-accounts --local          # offline: files, key pair, git identity, pass entries, symlink
    pi-accounts --quiet          # print only failures (for the weekly agenda row)
    pi-accounts --json           # machine-readable

Exit: 0 all green, 1 a named failure, 2 usage/error. Nothing here prints a secret: entries are
tested by decrypting one line and checking it is non-empty, never by echoing it.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
AGENT = os.path.join(HOME, ".pi", "agent")
IDENTITY = os.path.join(AGENT, "IDENTITY.md")
LINK = os.path.join(HOME, "IDENTITY.md")
KEY = os.path.join(HOME, ".ssh", "id_ed25519_prometheus")
PUB = KEY + ".pub"
LOGIN = "SyntheticPrometheus"
EMAIL = "prometheussynthetic@gmail.com"
REPOS = ("synthetic-prometheus", "pergola")
PASS_ENTRIES = (
    "github/token",
    "github/SyntheticPrometheus",
    "google/prometheussynthetic",
    "pi/github-webhook-topic",
    "pi/text-topic",
)

results: list[dict] = []


def record(name: str, ok: bool, detail: str) -> None:
    results.append({"check": name, "ok": ok, "detail": detail})


def run(cmd: list[str], timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def check_files() -> None:
    record("identity", os.path.isfile(IDENTITY) and os.path.getsize(IDENTITY) > 500,
           IDENTITY if os.path.isfile(IDENTITY) else "missing")
    try:
        record("home-link", os.path.realpath(LINK) == os.path.realpath(IDENTITY),
               "~/IDENTITY.md -> " + os.path.realpath(LINK))
    except OSError as exc:
        record("home-link", False, str(exc))

    name = run(["git", "config", "--global", "user.name"]).stdout.strip()
    email = run(["git", "config", "--global", "user.email"]).stdout.strip()
    record("git-identity", name == LOGIN and email == EMAIL, f"{name} <{email}>")

    if not os.path.isfile(KEY):
        record("ssh-key", False, "missing " + KEY)
        return
    mode = oct(os.stat(KEY).st_mode & 0o777)
    derived = run(["ssh-keygen", "-y", "-f", KEY]).stdout.strip().split()
    published = open(PUB).read().strip().split() if os.path.isfile(PUB) else []
    same = bool(derived) and derived[:2] == published[:2]
    record("ssh-key", same and mode in ("0o600", "0o400"), f"mode {mode}, pub matches {same}")

    missing = []
    for entry in PASS_ENTRIES:
        proc = run(["pass", "show", entry])
        if proc.returncode != 0 or not proc.stdout.strip():
            missing.append(entry)
    record("pass", not missing, "all entries decrypt" if not missing else "missing: " + ", ".join(missing))


def check_network() -> None:
    ssh = run(["ssh", "-o", "BatchMode=yes", "-T", "git@github.com"], timeout=25)
    banner = (ssh.stdout + ssh.stderr).strip().splitlines()
    hello = banner[0] if banner else ""
    record("github-ssh", hello.startswith("Hi " + LOGIN + "!"), hello or "no banner")

    token = run(["pass", "show", "github/token"]).stdout.strip()
    env = dict(os.environ, GH_TOKEN=token)
    try:
        who = subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True,
                             text=True, timeout=25, env=env)
        login = who.stdout.strip()
        record("github-api", who.returncode == 0 and login == LOGIN, login or who.stderr.strip()[:120])
        auth = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True,
                              timeout=25, env=env)
        scopes = [line.split(":", 1)[-1].strip() for line in (auth.stderr + auth.stdout).splitlines()
                  if "Token scopes" in line]
        found = scopes[0] if scopes else ""
        record("github-scopes", "repo" in found, found or "no scope line")
        for repo in REPOS:
            view = subprocess.run(["gh", "repo", "view", f"{LOGIN}/{repo}", "--json", "name,visibility"],
                                  capture_output=True, text=True, timeout=25, env=env)
            ok = view.returncode == 0
            detail = json.loads(view.stdout)["visibility"] if ok else view.stderr.strip()[:120]
            record("repo-" + repo, ok, detail)
    except FileNotFoundError as exc:
        record("github-api", False, str(exc))

    try:
        mail = run([os.path.join(AGENT, "bin", "pi-mail"), "check", "--n", "1"], timeout=60)
        line = (mail.stdout + mail.stderr).strip().splitlines()
        record("mail", mail.returncode == 0, line[0][:160] if line else "no output")
    except subprocess.TimeoutExpired:
        record("mail", False, "timeout after 60 s")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--local", action="store_true", help="offline checks only")
    ap.add_argument("--quiet", action="store_true", help="print only failures")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    try:
        check_files()
        if not args.local:
            check_network()
    except Exception as exc:  # a check that crashes is a failed check, named
        record("internal", False, f"{type(exc).__name__}: {exc}")

    bad = [r for r in results if not r["ok"]]
    if args.json:
        print(json.dumps({"ok": not bad, "checks": results}, indent=2))
    else:
        for r in results:
            if r["ok"] and args.quiet:
                continue
            print(("ok   " if r["ok"] else "FAIL ") + r["check"] + ": " + r["detail"])
        if not args.quiet:
            print(f"{len(results) - len(bad)}/{len(results)} green")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
