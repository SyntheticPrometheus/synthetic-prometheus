#!/usr/bin/env python3
"""pi-publish — build a sanitized public snapshot of the harness + dotfiles and push it rarely.

  pi-publish                 plan only: what would change, secret scan, size check (no network)
  pi-publish --push          build, commit and push IF the batching rules allow it
  pi-publish --force         push regardless of the batching rules (first publish, or a fix)
  pi-publish --status        show the batching state and the remote

Why it is deliberately slow: GitHub dislikes push floods, and a public snapshot is not a backup of
my working tree. One squashed commit per cycle, only when there is something worth reading, never
more often than a busy human maintainer would publish.

Rules (state in publish/state.json):
  - refuse to push if any secret pattern matches, or a file is > 512 KB, or total > 20 MB;
  - skip unless (changed files >= min_changed_files) or (days since last push >= min_days);
  - at most max_pushes_per_7d pushes in any rolling 7 days, --force excepted;
  - additionally: <= max_pushes_per_24h in a day, >= min_gap_h between pushes, and only inside
    the local "window" hours -- the cadence of an active human, not of a cron (rates and hours
    measured from 329 contributor-repos in six public repos: research/github-activity-cadence.md).

Every push that lands sends one ntfy text to the owner (the confirmed path only, so a refused push
is silent); PI_PUSH_NOTIFY=0 turns it off. tests/pi-publish.sh pins both directions.
"""
import argparse
import filecmp
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
AGENT = HOME / ".pi" / "agent"
PUB = AGENT / "publish"
DST = PUB / "repo"
STATE = PUB / "state.json"
STATUS = PUB / "status.json"   # last attempt: outcome + reason (never silent)
REMOTE = "git@github.com:SyntheticPrometheus/synthetic-prometheus.git"

# explicit allowlist, relative to ~/.pi/agent. Nothing else is ever copied.
ALLOW = [
    "AGENTS.md", "IDENTITY.md", "mcp.json",
    "agents", "skills", "prompts", "extensions", "research",
    "bin/mem", "bin/mem.py", "bin/layaq", "bin/pi-attach", "bin/pi-delegate", "bin/pi-term",
    "bin/pi-publish", "bin/pi-github-bootstrap", "bin/pi-preflight", "bin/pi-secret",
    "bin/pi-accounts", "bin/pi-mail",
    "bin/pi-review", "bin/pi-commit-guard.py",
    "bin/pi-falsify", "bin/pi-probe", "bin/pi-core-map",
    "core/brain-map.json", "core/brain-map-index.tsv",
    "PUBLISHING.md", "PASSWORDS.md", "RUNBOOK-accounts.md", "INCIDENTS.md",
    "delegation/README.md", "delegation/policy.md",
    "laya/NOTES.md", "laya/bench.py", "laya/mcp_probe.py", "laya/probe2.py",
    "selfimprove/DESIGN.md", "selfimprove/decisions.md", "selfimprove/suite", "selfimprove/arms",
    "selfimprove/audit.py", "selfimprove/gate.py", "selfimprove/maintain.py",
    "selfimprove/policy.json", "selfimprove/propose.py", "selfimprove/run.py",
    "selfimprove/selftest.py", "selfimprove/selftest_gate.py", "selfimprove/fixtures.py",
    "selfimprove/review.md",
]
DOTFILES = [
    ".bashrc", ".bash_profile",
    ".config/systemd/user/pi-selfimprove.service",
    ".config/systemd/user/pi-selfimprove.timer",
    ".config/systemd/user/pi-review.service",
    ".config/systemd/user/pi-review.timer",
    ".config/systemd/user/pi-publish.timer",
    ".config/systemd/user/pi-publish.service",
    ".config/autostart/pi-terminal.desktop",
]
# `.litwalk-cache` holds raw OpenAlex/arXiv batches (13 MB, single files up to 641 KB): cache
# material, never snapshot material, and it is inside the allowlisted `research/`. The digests
# beside it are what gets published.
EXCLUDE_NAMES = {".git", "__pycache__", "runs", "auth.json", "state.json", ".venv",
                 ".litwalk-cache"}
TEXT_EXT = {".md", ".py", ".sh", ".ts", ".json", ".service", ".timer", ".desktop", ".toml",
            ".yaml", ".yml", ".txt", ""}

SECRETS = [
    (r"sk-[A-Za-z0-9_-]{20,}", "openai-style key"),
    (r"gh[pousr]_[A-Za-z0-9]{20,}", "github token"),
    (r"github_pat_[A-Za-z0-9_]{20,}", "github fine-grained token"),
    (r"xox[baprs]-[A-Za-z0-9-]{10,}", "slack token"),
    (r"AKIA[0-9A-Z]{16}", "aws key id"),
    (r"-----BEGIN [A-Z ]*PRIVATE KEY-----", "private key"),
    (r"(?i)(api[_-]?key|secret|password)\s*[:=]\s*['\"][A-Za-z0-9/+=_-]{12,}['\"]", "inline credential"),
]

# `TOPIC_SECRET = "pi/text-topic"` names a `pass` entry, not a value: the secret is
# retrieved by pi-secret at run time. The generic inline-credential pattern cannot
# tell the two apart, so a `pi/` path gets an exemption — same rule pi-commit-guard
# applies. Without it the guard's own documentation comment blocks every publish.
PASS_ENTRY = re.compile(r"""(?i)(api[_-]?key|secret|password)\s*[:=]\s*['\"]pi/[a-z0-9._/-]{2,}['\"]""")

# Raw research caches are large and not snapshot material; the digests beside them are.
EXCLUDE_REL = {"research/cc"}

# Rate: the peer is a top-15% regular contributor, not the median account and not the median
# regular (owner, 2026-11-19: acting like a top 85-95% contributor is not a ban risk when the
# behaviour matches humans at that level). Measured over 1,863 commits / 21 regulars, 180 d:
# commits/week p50 10.0, p75 17.4, p85 28.0, p90 53.3 — 28/week is ~4/day, which is what the
# 14 pushes/week cap allows once a push carries more than one commit. Shape matters more than
# rate: 75% of a top-decile author's consecutive commits fall <60 min apart (a session), so the
# gap floor is 15 min, not the 1.5 h that made every cluster impossible.
DEFAULTS = {"min_changed_files": 3, "min_days": 7, "max_pushes_per_7d": 14,
            "max_pushes_per_24h": 4, "min_gap_h": 0.25, "window": [8, 22],
            "max_file_kb": 512, "max_total_mb": 20, "last_push": 0, "history": []}


def notify_pushed(changed, total):
    """Say it on the phone the moment a push lands (owner, 2026-11-15).

    Only on the confirmed path: a refused push says nothing, so the text never claims something
    that did not happen. Never raises and never changes the exit code: a phone that is offline is
    not a failed publish.
    """
    if os.environ.get("PI_PUSH_NOTIFY", "1") == "0":
        return
    msg = (f"pushed to GitHub: {changed} file(s), {total // 1024} KB "
           f"-> synthetic-prometheus @ {time.strftime('%H:%M')}")
    try:
        out = subprocess.run([str(AGENT / "bin" / "pi-text"), "send", "--quiet",
                              "--title", "pi push", msg],
                             capture_output=True, text=True, timeout=30)
        if out.returncode != 0:
            print(f"notify failed (push stands): {(out.stderr or out.stdout).strip()[:200]}")
    except Exception as exc:  # noqa: BLE001 — the push already happened; a text is not the gate
        print(f"notify failed (push stands): {exc}")


def record(outcome, reason, changed=0):
    """Every run leaves a trace, so --status can tell 'waiting' from 'broken'."""
    try:
        PUB.mkdir(parents=True, exist_ok=True)
        STATUS.write_text(json.dumps({"ts": time.time(), "outcome": outcome, "reason": reason,
                                      "changed": changed}, indent=1) + "\n")
    except Exception:
        pass


def last_status():
    try:
        return json.loads(STATUS.read_text())
    except Exception:
        return None


def load_state():
    if STATE.exists():
        s = json.loads(STATE.read_text())
    else:
        s = {}
    return {**DEFAULTS, **s}


def save_state(s):
    PUB.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s, indent=1) + "\n")


def is_text(p):
    if p.suffix.lower() in TEXT_EXT:
        return True
    try:
        p.read_text()
        return True
    except Exception:
        return False


GPG_FPR = "<gpg-key-fingerprint>"


def redact(text):
    """Make the snapshot portable and keep the owner's machine name out of a public repo."""
    text = text.replace(str(HOME), "$HOME")
    text = text.replace("$HOME", "$HOME")
    text = re.sub(r"(?i)\bdaedalus\b", "host", text)
    # the store's key id is public, but a published template has no use for it
    text = text.replace(GPG_FPR, "<gpg-key-fingerprint>")
    return text


def walk(path):
    if path.is_file():
        yield path
    elif path.is_dir():
        for root, dirs, files in os.walk(path):
            dirs[:] = [d for d in dirs if d not in EXCLUDE_NAMES]
            for f in files:
                if f in EXCLUDE_NAMES:
                    continue
                yield Path(root) / f


def build_plan():
    """Return the list of (source, destination) pairs and the total size."""
    pairs = []
    for rel in ALLOW:
        src = AGENT / rel
        if not src.exists():
            continue
        for f in walk(src):
            r = f.relative_to(AGENT)
            if any(str(r) == d or str(r).startswith(d + "/") for d in EXCLUDE_REL):
                continue
            pairs.append((f, Path("agent") / r))
    for rel in DOTFILES:
        src = HOME / rel
        if src.exists():
            pairs.append((src, Path("dotfiles") / rel.lstrip(".")))
    etcl = Path("/etc/lightdm/lightdm.conf.d/50-autologin.conf")
    if etcl.exists():
        pairs.append((etcl, Path("dotfiles/etc/lightdm/50-autologin.conf")))
    return pairs


def scan(pairs):
    problems = []
    total = 0
    for src, rel in pairs:
        size = src.stat().st_size
        total += size
        if size > 512 * 1024:
            problems.append(f"{rel} is {size//1024} KB (> 512 KB)")
        if not is_text(src):
            continue
        body = src.read_text(errors="replace")
        for pat, label in SECRETS:
            for m in re.finditer(pat, body):
                if label == "inline credential" and PASS_ENTRY.search(m.group(0)):
                    continue
                problems.append(f"{rel}: looks like a {label}")
                break
        if "auth.json" in str(rel):
            problems.append(f"{rel}: auth file must never be published")
    if total > 20 * 1024 * 1024:
        problems.append(f"total snapshot {total//1024//1024} MB (> 20 MB)")
    return problems, total


LICENSE_TEXT = """MIT License

Copyright (c) 2026 SyntheticPrometheus

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
"""


def render(pairs):
    # never delete .git: the snapshot repo's history and remote live there
    if DST.exists():
        for child in DST.iterdir():
            if child.name == ".git":
                continue
            shutil.rmtree(child) if child.is_dir() else child.unlink()
    DST.mkdir(parents=True, exist_ok=True)
    changed = 0
    for src, rel in pairs:
        out = DST / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        if is_text(src):
            out.write_text(redact(src.read_text(errors="replace")))
        else:
            shutil.copy2(src, out)
        if not (PUB / "last" / rel).exists() or not filecmp.cmp(
                out, PUB / "last" / rel, shallow=False):
            changed += 1
    (DST / "LICENSE").write_text(LICENSE_TEXT)
    (DST / "README.md").write_text(readme(len(pairs)))
    if (AGENT / "PUBLISHING.md").exists():
        shutil.copy2(AGENT / "PUBLISHING.md", DST / "PUBLISHING.md")
    return changed


def readme(n_files):
    return f"""# synthetic-prometheus

The working harness and dotfiles of an unattended coding agent on a single Arch Linux machine:
prose protocol (`agent/AGENTS.md`), skills, the subagent roster, and a measured
self-improvement loop (`agent/selfimprove`) whose design and evidence live next to the code.

Published as periodic snapshots, not a mirror of the working tree — one squashed commit per cycle,
only when there is something worth reading. Secrets, sessions and personal memory are excluded by
an explicit allowlist; see `PUBLISHING.md`.

- `agent/` — harness: AGENTS.md, agents/, skills/, prompts/, extensions/, bin/, research/,
  selfimprove/ (design, decisions, suite, gate, audit, maintenance)
- `dotfiles/` — shell, systemd user units, autostart, lightdm autologin
- files: {n_files} · snapshot: {time.strftime('%Y-%m-%d')}

Research behind the loop: `agent/research/self-improving-harnesses.md`.
"""


def git(*args, cwd=None, check=True):
    return subprocess.run(["git", *args], cwd=cwd or DST, capture_output=True, text=True, check=False)


def plan(changed, total, problems, state, force=False, why=None, now=None):
    now = time.time() if now is None else now
    days = (now - state["last_push"]) / 86400 if state["last_push"] else 999
    windows = [t for t in state["history"] if now - t < 7 * 86400]
    day = [t for t in windows if now - t < 86400]
    last = max(windows) if windows else 0
    lo, hi = state.get("window", [8, 22])
    print(f"snapshot: {changed} changed file(s), {total//1024} KB")
    print(f"state: last push {days:.1f}d ago, {len(windows)} push(es) in the last 7d "
          f"(cap {state['max_pushes_per_7d']}/7d, {state['max_pushes_per_24h']}/24h), "
          f"window {lo:02d}:00-{hi:02d}:00 local")
    for p in problems:
        print("BLOCK:", p)
    if problems:
        return 3
    if force:
        print("FORCE: batching rules bypassed")
        return 0

    def skip(msg):
        print(f"SKIP: {msg}")
        if why is not None:
            why.append(("skip", msg))
        return 0

    # The fingerprint of a bot is when it posts, not only how often: a cron at 05:37 Monday
    # is a time no developer in this timezone posts (measured: 4% of real commits fall in
    # 00:00-06:00 local, 70% in 08:00-20:00; research/github-activity-cadence.md).
    hour = time.localtime(now).tm_hour
    if not (lo <= hour < hi):
        return skip(f"outside the {lo:02d}:00-{hi:02d}:00 local posting window "
                    f"(it is {hour:02d}:xx)")
    if len(day) >= state["max_pushes_per_24h"]:
        return skip(f"burst cap reached ({len(day)}/{state['max_pushes_per_24h']} in 24h)")
    gap_h = (now - last) / 3600 if last else 999
    if gap_h < state["min_gap_h"]:
        return skip(f"only {gap_h:.1f}h since the last push "
                    f"(min {state['min_gap_h']:g}h: humans do not push machine-fast)")
    if len(windows) >= state["max_pushes_per_7d"]:
        return skip(f"push cap reached ({len(windows)}/{state['max_pushes_per_7d']} in 7d)")
    if changed < state["min_changed_files"] and days < state["min_days"]:
        return skip(f"{changed} changed < {state['min_changed_files']} and only {days:.1f}d "
                    f"< {state['min_days']}d since the last push; "
                    f"next eligible in {state['min_days']-days:.1f}d")
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--push", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--remote", default=REMOTE)
    a = ap.parse_args()
    # `--force` is documented as "push regardless of the batching rules", so it implies --push:
    # --force alone used to build a snapshot and exit 0 with nothing on the remote (bug #332).
    if a.force:
        a.push = True
    state = load_state()

    if a.status:
        days = (time.time() - state["last_push"]) / 86400 if state["last_push"] else None
        print(f"remote: {a.remote}\nlast push: {f'{days:.1f}d ago' if days is not None else 'never'}")
        print(f"rules: {state['min_changed_files']} files or {state['min_days']}d, "
              f"max {state['max_pushes_per_7d']}/7d and {state['max_pushes_per_24h']}/24h, "
              f">= {state['min_gap_h']:g}h apart, only "
              f"{state['window'][0]:02d}:00-{state['window'][1]:02d}:00 local")
        print(f"repo dir: {DST}")
        st = last_status()
        if st:
            print(f"last attempt: {(time.time()-st['ts'])/86400:.1f}d ago — {st['outcome']}: {st['reason']}")
        else:
            print("last attempt: never recorded (run --push or the timer)")
        return 0

    pairs = build_plan()
    problems, total = scan(pairs)
    changed = render(pairs) if not problems else 0
    why = []
    rc = plan(changed, total, problems, state, a.force, why)
    if rc == 3:
        record("blocked", "; ".join(problems)[:400], changed)
    if rc or not a.push:
        if not a.push:
            print("plan only (use --push to publish)")
        record("plan", why[0][1] if why else "plan only", changed)
        return rc

    pre = subprocess.run([str(AGENT / "bin" / "pi-preflight"), "--quiet"],
                         capture_output=True, text=True)
    if pre.returncode != 0:
        print("PREFLIGHT FAILED — not publishing:")
        print(pre.stdout.strip()[-800:])
        record("blocked", "preflight failed: " + pre.stdout.strip().replace("\n", " ")[:300], changed)
        return 5
    state_ok = plan(changed, total, problems, state, a.force, why)
    if state_ok or not changed:
        record("skip", why[0][1] if why else f"nothing changed ({changed} file(s))", changed)
        return state_ok


    if (DST / ".git" / "rebase-merge").exists() or (DST / ".git" / "rebase-apply").exists():
        subprocess.run(["git", "rebase", "--abort"], cwd=DST, capture_output=True, text=True)
    if not (DST / ".git").exists():
        git("init", "-q")
        git("checkout", "-q", "-b", "main")
        git("remote", "add", "origin", a.remote)
    else:
        # keep the local branch name aligned with the remote so HEAD:main is not a cross-branch push
        git("checkout", "-q", "-B", "main")
        # --remote must win on an existing repo too: it is how a trial run points at a throwaway
        # bare repo instead of publishing, and an ignored flag publishes by accident.
        subprocess.run(["git", "remote", "set-url", "origin", a.remote],
                       cwd=DST, capture_output=True, text=True)
    git("add", "-A")
    msg = f"snapshot {time.strftime('%Y-%m-%d')}: {changed} file(s) changed"
    git("-c", "user.email=agent@local", "-c", "user.name=SyntheticPrometheus",
        "commit", "-q", "-m", msg)
    print(f"committed: {msg}")
    out = subprocess.run(["git", "push", "-q", "origin", "HEAD:main"],
                         cwd=DST, capture_output=True, text=True)
    if out.returncode != 0 and ("fetch first" in (out.stderr or "") or "rejected" in (out.stderr or "")):
        # the remote moved. This repo is a snapshot, not a history: take the remote as the base and
        # re-commit the current tree on top of it. (A rebase conflicts here — every file is "added"
        # on both sides — and leaves the repo stuck mid-rebase, which is how a push silently no-ops.)
        subprocess.run(["git", "fetch", "-q", "origin", "main"], cwd=DST, capture_output=True, text=True)
        subprocess.run(["git", "reset", "-q", "--hard", "origin/main"], cwd=DST, capture_output=True, text=True)
        render(pairs)  # the reset wiped the working tree; rebuild the snapshot before committing
        subprocess.run(["git", "add", "-A"], cwd=DST, capture_output=True, text=True)
        subprocess.run(["git", "-c", "user.email=agent@local", "-c", "user.name=SyntheticPrometheus",
                        "commit", "-q", "-m", msg], cwd=DST, capture_output=True, text=True)
        out = subprocess.run(["git", "push", "-q", "origin", "HEAD:main"],
                             cwd=DST, capture_output=True, text=True)
    if out.returncode != 0:
        print("PUSH FAILED (no credentials or no remote yet):")
        print((out.stderr or out.stdout).strip()[:600])
        print("\nnext: gh auth login   (or add the SSH key and re-run)")
        record("failed", "push rejected: " + (out.stderr or out.stdout).strip().replace("\n", " ")[:250], changed)
        return 4
    last = PUB / "last"
    if last.exists():
        shutil.rmtree(last)
    shutil.copytree(DST, last, ignore=shutil.ignore_patterns(".git"))
    state["last_push"] = time.time()
    state["history"] = [t for t in state["history"] if time.time() - t < 30 * 86400] + [time.time()]
    save_state(state)
    record("pushed", f"{changed} file(s), {total//1024} KB", changed)
    notify_pushed(changed, total)
    print("pushed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
