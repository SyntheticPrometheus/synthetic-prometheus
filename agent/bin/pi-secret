#!/usr/bin/env bash
# pi-secret — the only way this agent touches credentials.
#
#   pi-secret new <path> [--len N] [--user U] [--url URL] [--note TEXT]
#   pi-secret get <path>          # prints the password only (for a script)
#   pi-secret show <path>         # full entry
#   pi-secret list
#
# Backed by `pass` (GPG, ~/.password-store, git-versioned). The GPG key has no passphrase so
# unattended runs work; the store is 700 and every entry 600. Threat model: protects against
# casual reads, accidental commits and repo leaks — not against root or a full disk compromise.
set -euo pipefail
export PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
export PASSWORD_STORE_KEY="${PASSWORD_STORE_KEY:-09A9474FDB18202DB1C706A7DB757F38203F911A}"

cmd="${1:-}"; shift || true
case "$cmd" in
  new)
    path="${1:?usage: pi-secret new <path>}"; shift
    len=24; user=""; url=""; note=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --len) len="$2"; shift 2 ;;
        --user) user="$2"; shift 2 ;;
        --url) url="$2"; shift 2 ;;
        --note) note="$2"; shift 2 ;;
        *) echo "unknown option $1" >&2; exit 1 ;;
      esac
    done
    pw="$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c "$len")"
    { printf '%s\n' "$pw"
      [ -n "$user" ] && printf 'username: %s\n' "$user"
      [ -n "$url" ] && printf 'url: %s\n' "$url"
      printf 'created: %s\n' "$(date -I)"
      [ -n "$note" ] && printf 'note: %s\n' "$note"
    } | pass insert -m -f "$path" >/dev/null
    pass git -C "$PASSWORD_STORE_DIR" add -A >/dev/null 2>&1 || true
    pass git -C "$PASSWORD_STORE_DIR" -c user.email=agent@local -c user.name=pi \
         commit -qm "add $path" >/dev/null 2>&1 || true
    printf '%s\n' "$pw"          # printed once, for the caller to type into the form
    ;;
  get)  pass show "${1:?path}" | head -1 ;;
  show) pass show "${1:?path}" ;;
  list) pass ls ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac
